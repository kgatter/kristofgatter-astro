---
import {
  MESH_GRID,
  MESH_GRID_COLS,
  MESH_GRID_PAD,
  MESH_GRID_ROWS,
} from "./mesh-grid";

interface Props {
  variant?: "static" | "lively" | "calm";
  grain?: boolean;
  fixed?: boolean;
  scrollPan?: boolean;
}

const { variant = "lively", grain = true, fixed = false, scrollPan = false } =
  Astro.props;

const BLUR = 0.7;

const filterId = `mesh-blur-${Math.random().toString(36).slice(2, 8)}`;

const GRAIN_SVG = `<svg xmlns='http://www.w3.org/2000/svg' width='128' height='128'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='128' height='128' filter='url(#n)'/></svg>`;
const GRAIN_URI = `url("data:image/svg+xml,${encodeURIComponent(GRAIN_SVG)}")`;
---

<div
  class:list={["mesh-backdrop", { fixed }]}
  data-mesh-backdrop
  data-motion={variant}
  data-scroll-pan={scrollPan ? "" : undefined}
  aria-hidden="true"
>
  <svg
    viewBox={`0 0 ${MESH_GRID_COLS} ${MESH_GRID_ROWS}`}
    preserveAspectRatio="xMidYMid slice"
  >
    <defs>
      <filter
        id={filterId}
        x="-20%"
        y="-20%"
        width="140%"
        height="140%"
        color-interpolation-filters="sRGB"
      >
        <feGaussianBlur stdDeviation={BLUR}></feGaussianBlur>
      </filter>
    </defs>
    <g filter={`url(#${filterId})`}>
      {
        MESH_GRID.map((row, r) =>
          row.map((color, c) => (
            <rect
              x={c - MESH_GRID_PAD}
              y={r - MESH_GRID_PAD}
              width={1.02}
              height={1.02}
              fill={color}
            />
          )),
        )
      }
    </g>
  </svg>
  {grain && <div class="grain" style={`background-image: ${GRAIN_URI};`}></div>}
  <div class="scrim"></div>
</div>

<style>
  .mesh-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .mesh-backdrop.fixed {
    position: fixed;
    z-index: -10;
    pointer-events: none;
  }

  .mesh-backdrop svg,
  .mesh-backdrop :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.06;
    background-repeat: repeat;
  }

  .scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: background-color 1500ms ease-out;
  }
</style>

<script>
  import { mountMeshCanvas } from "./mesh-canvas";
  import type { MeshSurfaceControl } from "./mesh-canvas";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const darkScheme = window.matchMedia("(prefers-color-scheme: dark)");

  const pageSurface = (): [number, number, number] => {
    const rgb = getComputedStyle(document.body).backgroundColor.match(/\d+/g);
    return rgb
      ? [Number(rgb[0]), Number(rgb[1]), Number(rgb[2])]
      : [255, 255, 255];
  };

  for (const host of document.querySelectorAll<HTMLElement>(
    "[data-mesh-backdrop]",
  )) {
    const motion = host.dataset.motion;
    const scrollPan = host.dataset.scrollPan !== undefined;
    const scrim = host.querySelector<HTMLElement>(".scrim");

    const control: { current: MeshSurfaceControl } = {
      current: { color: pageSurface(), mix: 0 },
    };

    const zones = [
      ...document.querySelectorAll<HTMLElement>("[data-backdrop]"),
    ].map((el) => ({ el, kind: el.dataset.backdrop ?? "page" }));

    const update = () => {
      if (zones.length === 0) return;
      const anchor = window.innerHeight / 2;

      let kind = zones[0].kind;
      for (let i = 0; i < zones.length - 1; i++) {
        const prevBottom = zones[i].el.getBoundingClientRect().bottom;
        const nextTop = zones[i + 1].el.getBoundingClientRect().top;
        if (anchor >= (prevBottom + nextTop) / 2) {
          kind = zones[i + 1].kind;
        } else {
          break;
        }
      }

      const color = pageSurface();
      const mix = kind === "mesh" ? 0 : 1;
      control.current.color = color;
      control.current.mix = mix;
      const ink =
        kind === "mesh"
          ? "255 255 255"
          : (getComputedStyle(document.body).color.match(/\d+/g) ?? [
              "33",
              "37",
              "41",
            ])
              .slice(0, 3)
              .join(" ");
      document.documentElement.style.setProperty("--backdrop-ink", ink);
      if (scrim) {
        scrim.style.backgroundColor = reduceMotion.matches
          ? `rgba(${color[0]}, ${color[1]}, ${color[2]}, ${mix.toFixed(3)})`
          : "";
      }
    };

    if (zones.length > 0) {
      update();
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
      darkScheme.addEventListener("change", update);
    }

    if (motion !== "lively" && motion !== "calm") continue;

    let canvas: HTMLCanvasElement | null = null;
    let unmount: (() => void) | null = null;

    const sync = () => {
      update();
      if (reduceMotion.matches) {
        unmount?.();
        canvas?.remove();
        unmount = null;
        canvas = null;
        return;
      }
      if (unmount) return;
      canvas = document.createElement("canvas");
      host.querySelector("svg")?.after(canvas);
      unmount = mountMeshCanvas(canvas, {
        motion,
        scrollPan,
        surfaceControl: control,
      });
      if (!unmount) {
        canvas.remove();
        canvas = null;
      }
    };
    sync();
    reduceMotion.addEventListener("change", sync);
  }
</script>
